# Clave de Google AI Studio para el Árbitro IA (gemini-2.5-flash).
# Si se deja vacía, el servidor usa el Árbitro Heurístico Local (fallback).
GEMINI_API_KEY=

# (Opcional) Modelo de Gemini a usar. Por defecto: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Puerto del servidor Express + Socket.IO (el proxy de Vite apunta a 3001).
PORT=3001
